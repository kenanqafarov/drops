generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WatchedStore {
  id        String           @id @default(cuid())
  url       String           @unique
  lastCheck DateTime         @default(now())
  products  WatchedProduct[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model WatchedProduct {
  id         String       @id @default(cuid())
  storeId    String
  store      WatchedStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  externalId String
  title      String
  price      Float
  inStock    Boolean
  lastPrice  Float?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model ProductScan {
  id        String   @id @default(cuid())
  source    String
  title     String
  price     Float
  score     Int
  raw       Json
  createdAt DateTime @default(now())
}
