# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here_for_testing

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dropshipping_db?schema=public

# AI Layer (xAI Grok API)
XAI_API_KEY=your_xai_grok_api_key_here
XAI_MODEL=grok-2-latest

# 3rd Party Data Sources & Ads APIs
META_ADS_LIBRARY_TOKEN=your_meta_ad_library_access_token_here
TIKTOK_DATA_PROVIDER_API_KEY=your_tiktok_or_kalodata_api_key_here

# Discord Channel Notifications
WINNING_PRODUCT_CHANNEL_ID=your_winning_product_channel_id_here
COMPETITOR_ALERT_CHANNEL_ID=your_competitor_alert_channel_id_here
DAILY_DIGEST_CHANNEL_ID=your_daily_digest_channel_id_here

# Scheduler Settings
DAILY_DIGEST_HOUR=8
SCAN_INTERVAL_MINUTES=30
COMPETITOR_CHECK_MINUTES=15

# Express Health Check Server Port
PORT=3000
